# ---------------------------------------------------------------------------
# Example environment file.
#
# Copy to .env and fill in the blanks:  cp .env.example .env
# Every variable the backend reads is listed here. Values that are secrets are
# left empty on purpose -- never commit a real one.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# PostgreSQL connection string used by Prisma and by prisma/seed.ts.
DATABASE_URL=postgresql://ics_app:CHANGE_ME@localhost:5432/ics?schema=public

# --- Authentication --------------------------------------------------------
# Signing key for access tokens. Required: the app refuses to start without it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Value written to the token's "iss" claim.
JWT_ISSUER=ics
# Access-token lifetime in seconds (3600 = one hour).
JWT_EXPIRES_IN=3600

# --- Object storage (MinIO / S3) -------------------------------------------
# Credentials are required: there is no default, so a missing value stops the
# app at startup instead of quietly using the well-known minioadmin account.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# The rest have development defaults and can be left as they are locally.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=ics-documents

# --- HTTP ------------------------------------------------------------------
# Port the API listens on (default 3000).
PORT=3000
# Comma-separated list of browser origins allowed to call this API.
# Defaults to the local Next.js dev server when empty.
CORS_ORIGINS=http://localhost:3001

# --- Working-hours policy --------------------------------------------------
# Comma-separated IP prefixes exempt from the working-hours restriction, e.g.
# the campus network: 10.0.,192.168.  Loopback is always allowed.
# Leave empty to disable the exemption entirely.
STAFF_IP_ALLOWLIST=

# --- Notification retention ------------------------------------------------
# How many days of notifications to keep, and how often the sweep runs.
NOTIFICATION_RETENTION_DAYS=30
NOTIFICATION_RETENTION_SWEEP_HOURS=24
